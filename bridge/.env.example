# Simpan file JSON di luar repository. Tidak ada private key di file ini.
GOOGLE_APPLICATION_CREDENTIALS=C:/Users/ANDA/secrets/tradingview-service-account.json
FIREBASE_PROJECT_ID=tradingview-remote
# Wajib UID pemilik; bridge menolak dijalankan jika masih placeholder.
OWNER_UID=OWNER_UID
# Gunakan binary native .exe di Windows, bukan shim .cmd/.ps1.
CODEX_EXECUTABLE=C:/path/to/codex.exe
# Opsional; default ~/.codex/config.toml. Hanya server tradingview yang diambil.
CODEX_CONFIG_PATH=
# Lokasi untuk panduan peluncuran manual; bridge tidak meluncurkan aplikasi ini.
TRADINGVIEW_EXECUTABLE=C:/path/to/TradingView.exe
JOB_TIMEOUT_MS=180000
# Opsional jika MCP menyimpan screenshot di lokasi nonstandar.
# Default diinfer dari lokasi .../tradingview-mcp/src/server.js → .../screenshots.
TRADINGVIEW_SCREENSHOT_DIR=
